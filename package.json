{
  "name": "lyon-redm-launcher",
  "version": "0.1.0",
  "description": "Source-available non-commercial RedM server launcher and installer for RSG, VORP and RedEM:RP.",
  "author": "Lyon Scripts",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/Lyonsdev/lyon-redm-launcher#readme",
  "main": "src/main.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lyonsdev/lyon-redm-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/Lyonsdev/lyon-redm-launcher/issues"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run icon && electron-builder --win nsis portable",
    "pack": "npm run icon && electron-builder --dir",
    "lint": "node --check src/main.js && node --check src/preload.js && node --check src/installer.js && node --check src/recipeEngine.js && node --check src/artifacts.js && node --check src/windows.js && node --check src/state.js && node --check src/config.js && node --check app/renderer.js"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "mysql2": "^3.15.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.lyonscripts.redm.launcher",
    "productName": "Lyon RedM Launcher",
    "copyright": "Copyright (c) 2026 Lyon Scripts",
    "asar": true,
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "assets/**/*",
      "!assets/*.zip",
      "!assets/fonts/chinese-rocks.otf",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lyon RedM Launcher"
    }
  }
}
